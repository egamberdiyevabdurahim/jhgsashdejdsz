{
  "bank": "C1",
  "about": {
    "en": "Coded error rules behind the distractors of the C1 practice families. families[id] lists the rule of each distractor in order (distractors or option_templates[1..3]). Practice feedback may show the rule's line when a student picks that distractor."
  },
  "rules": {
    "sign_slip": {
      "en": "A minus sign was lost or flipped.",
      "uz": "Minus belgisi tushib qolgan yoki teskari olingan.",
      "ru": "Потерян или перевёрнут знак минус."
    },
    "order_of_operations": {
      "en": "The operations were done in the wrong order.",
      "uz": "Amallar notoʻgʻri tartibda bajarilgan.",
      "ru": "Действия выполнены в неправильном порядке."
    },
    "wrong_formula": {
      "en": "A related but wrong formula or rule was used.",
      "uz": "Oʻxshash, lekin notoʻgʻri formula yoki qoida ishlatilgan.",
      "ru": "Использована похожая, но неверная формула или правило."
    },
    "wrong_operation": {
      "en": "The wrong operation was used (for example, adding instead of multiplying).",
      "uz": "Notoʻgʻri amal bajarilgan (masalan, koʻpaytirish oʻrniga qoʻshilgan).",
      "ru": "Выбрано не то действие (например, сложение вместо умножения)."
    },
    "partial_answer": {
      "en": "The work stopped early: this is an in-between value, not the answer to the question.",
      "uz": "Yechim oxiriga yetkazilmagan: bu oraliq qiymat, savolga javob emas.",
      "ru": "Решение не доведено до конца: это промежуточное значение, а не ответ на вопрос."
    },
    "inverse_slip": {
      "en": "A ratio or a division was turned upside down.",
      "uz": "Nisbat yoki boʻlish teskari olingan.",
      "ru": "Отношение или деление перевёрнуто."
    },
    "place_value": {
      "en": "A digit or the decimal point is in the wrong place (a factor of 10 is off).",
      "uz": "Raqam yoki vergul notoʻgʻri xonada (10 marta farq qiladi).",
      "ru": "Цифра или запятая стоит не в том разряде (ошибка в 10 раз)."
    },
    "carry_slip": {
      "en": "A carried ten was forgotten or carried twice.",
      "uz": "Keyingi xonaga oʻtkaziladigan oʻnlik unutilgan yoki ikki marta qoʻshilgan.",
      "ru": "Перенос в следующий разряд забыт или сделан дважды."
    },
    "borrow_slip": {
      "en": "Borrowing went wrong (for example, the smaller digit was taken from the larger one in each column).",
      "uz": "Qarz olish xato bajarilgan (masalan, har bir xonada kichik raqam kattasidan ayirilgan).",
      "ru": "Ошибка при заёме (например, в каждом разряде из большей цифры вычтена меньшая)."
    },
    "off_by_one": {
      "en": "The count is off by one.",
      "uz": "Sanoq bittaga xato.",
      "ru": "Счёт сбился на единицу."
    },
    "unit_slip": {
      "en": "A unit was converted wrongly or not at all.",
      "uz": "Oʻlchov birligi notoʻgʻri oʻtkazilgan yoki umuman oʻtkazilmagan.",
      "ru": "Единица измерения переведена неверно или не переведена."
    },
    "additive_reasoning": {
      "en": "A difference was kept where a ratio should be kept (adding instead of scaling).",
      "uz": "Nisbat oʻrniga ayirma saqlangan (koʻpaytirish oʻrniga qoʻshilgan).",
      "ru": "Сохранена разность вместо отношения (прибавили вместо того, чтобы умножить)."
    },
    "square_slip": {
      "en": "(a ± b)² was treated as a² ± b², or a² − b² as (a − b)².",
      "uz": "(a ± b)² ni a² ± b² deb yoki a² − b² ni (a − b)² deb olingan.",
      "ru": "(a ± b)² принято за a² ± b² или a² − b² за (a − b)²."
    },
    "exponent_slip": {
      "en": "A power rule was misapplied (for example, x² read as 2x).",
      "uz": "Daraja qoidasi notoʻgʻri qoʻllangan (masalan, x² ni 2x deb olingan).",
      "ru": "Неверно применено правило степеней (например, x² принято за 2x)."
    },
    "rounding_slip": {
      "en": "Rounded the wrong way for the question.",
      "uz": "Savolga mos boʻlmagan tomonga yaxlitlangan.",
      "ru": "Округлено не в ту сторону, которая нужна по условию."
    },
    "percent_base": {
      "en": "The percent was taken of the wrong amount.",
      "uz": "Foiz notoʻgʻri miqdordan olingan.",
      "ru": "Процент взят не от той величины."
    },
    "diameter_radius": {
      "en": "The diameter was used where the radius was needed.",
      "uz": "Radius oʻrniga diametr olingan.",
      "ru": "Вместо радиуса взят диаметр."
    },
    "extraneous_root": {
      "en": "A solution that does not fit the situation was kept.",
      "uz": "Masala shartiga mos kelmaydigan yechim olingan.",
      "ru": "Взято решение, которое не подходит по смыслу задачи."
    },
    "chain_slip": {
      "en": "The derivative of the inner function was left out.",
      "uz": "Ichki funksiyaning hosilasi tushirib qoldirilgan.",
      "ru": "Пропущена производная внутренней функции."
    }
  },
